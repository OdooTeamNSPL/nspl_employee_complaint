<odoo>
    <record id="view_employee_form_inherit_complaint" model="ir.ui.view">
        <field name="name">hr.employee.form.complaint</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page string="Employee Complaints">
                    <field name="complaint_ids">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="complaint_name"/>
                            <field name="has_effect_on_work"/>
                            <field name="has_financial_effect"/>
                            <field name="state"/>
                        </tree>

                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
